<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET 10 compiled ahead of time. Native AOT produces a self contained native
      executable: no .NET runtime has to be installed, nothing is JIT compiled at
      start, and the process starts in a few milliseconds.
      The price is paid in bytes - see the size table in README.md - and in the two
      native libraries Avalonia needs next to the executable (Skia and HarfBuzz),
      which is why the release is a small zip instead of a bare .exe.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <!-- Runs the trim/AOT analyzers on every ordinary build, not only on publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Lets the project build (not publish) on a non Windows machine. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <!--
      Globalization stays on. InvariantGlobalization would save a little, but the
      program formats dates for a Chinese UI and reads a market code that is a
      culture name; ICU is part of Windows since 1903, so nothing has to ship for it.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Avalonia's Win32 backend needs the built in COM interop (clipboard, drag and drop). -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Exception messages are the diagnostic channel here, so the resource strings stay. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
    <AssemblyTitle>必应壁纸</AssemblyTitle>
    <Product>必应壁纸</Product>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Copyright>Copyright © 2026 pexcn · GPL-3.0-or-later</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Avalonia.Win32 and Avalonia.Skia rather than the Avalonia.Desktop meta package:
      this program only ever runs on Windows, and Desktop would drag the X11 and
      macOS backends plus a D-Bus client into the output.
    -->
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.20" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same file twice: ApplicationIcon above puts it in the Win32 resources of
      the executable (Explorer, task bar, Alt+Tab), this embeds it so the tray and
      the window title bars can pick the frame that matches the current DPI.
      See UI/AppIcon.cs. The logical name is spelled out instead of relying on the
      RootNamespace plus folder convention.
    -->
    <EmbeddedResource Include="Resources\app.ico">
      <LogicalName>BingWallpaper.Resources.app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
