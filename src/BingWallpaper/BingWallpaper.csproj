<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET Framework 4.8 on purpose: it is the newest runtime that ships *inside*
      Windows 10 (1903 and later, which includes LTSC 2021 / build 19044), so the
      executable stays a couple of hundred KB and needs no runtime install.
      No version of modern .NET (5 through 10) is part of Windows, which is why a
      .NET 10 build either needs a runtime install or a ~47 MB self contained exe.
      4.8.1 is not an option: it is only in-box on Windows 11 22H2 and later.
    -->
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- No NuGet packages, so no binding redirects and no .exe.config are needed. -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
    <AssemblyTitle>BingWallpaper</AssemblyTitle>
    <Product>BingWallpaper</Product>
    <Description>Unofficial, portable Bing daily wallpaper client for Windows.</Description>
    <Company>BingWallpaper contributors</Company>
    <Copyright>Copyright (c) BingWallpaper contributors</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Framework assemblies that ship with Windows. System.Drawing, System.Core and
      friends are referenced by the SDK already; these three are not.
      System.Web.Extensions provides JavaScriptSerializer, which replaces
      System.Text.Json (that one is not part of .NET Framework).
    -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
