<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      WinUI 3 (Windows App SDK) needs modern .NET and a Windows target platform;
      10.0.19041.0 is both the API surface WinUI itself is built against and this
      project's minimum Windows version (Windows 10 21H2 / LTSC 2021, build 19044,
      is comfortably above it).
      The two SelfContained switches are what makes the program portable again: the
      .NET runtime is compiled into the executable (see PublishAot below) and the
      Windows App SDK runtime is copied next to it, so the target machine needs
      neither installed. See the README for what that costs in size - this is no
      longer a 200 KB single file.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Unpackaged: no MSIX, no install, the folder is the application. -->
    <WindowsPackageType>None</WindowsPackageType>
    <UseWinUI>true</UseWinUI>
    <!--
      Native AOT: the program is compiled to machine code, so there is no CoreCLR,
      no JIT and no managed assemblies to load next to the executable. That removes
      the runtime files that made up the bulk of the publish output and takes the
      start-up cost of jitting the XAML stack with it.
      It also means the usual AOT rules apply to the whole code base: nothing may
      depend on code generated at run time. The XAML that matters here is compiled
      (x:Bind), the JSON is read element by element instead of deserialized, and the
      Win32 interop is blittable with an [UnmanagedCallersOnly] window procedure -
      see UI/TrayIcon.cs.
      Trimming comes with AOT and cannot be turned off; CsWinRTAotOptimizerEnabled
      is what makes the WinRT projections survive it.
    -->
    <PublishAot>true</PublishAot>
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <!-- Size over speed: this program spends its time waiting for a timer. -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <!-- The tray interop needs pointers; see the note in UI/TrayIcon.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
    <AssemblyTitle>必应壁纸</AssemblyTitle>
    <Product>必应壁纸</Product>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Copyright>Copyright © 2026 pexcn · GPL-3.0-or-later</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The WinUI component package rather than the Microsoft.WindowsAppSDK
      meta package. The Windows App SDK is modular since 2.0, and the meta package
      means "all of it": referencing it drags the AI, ML, Search and Widgets
      components into the publish folder - onnxruntime.dll and DirectML.dll alone
      are 40 MB of a program that shows pictures. This pulls WinUI plus what WinUI
      itself needs (Base, Foundation, InteractiveExperiences) and nothing else.
      DWriteCore is not among them on purpose: WinUI imports DWrite.dll, the one
      that is part of Windows.
      To move to a newer Windows App SDK, bump this one version.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same file twice: ApplicationIcon above puts it in the Win32 resources of
      the executable (Explorer, task bar, Alt+Tab), this embeds it so the tray and
      the window title bars can pick the frame that matches the current DPI.
      See UI/AppIcon.cs.
    -->
    <EmbeddedResource Include="Resources\app.ico">
      <LogicalName>BingWallpaper.Resources.app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
