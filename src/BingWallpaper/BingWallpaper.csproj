<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      .NET 10 plus Native AOT. Nothing of .NET is in-box on Windows, so the choice is
      between shipping a runtime installer, a ~70 MB self contained framework build or
      an ahead of time compiled executable. Native AOT keeps the one file, no install
      promise of the old .NET Framework 4.8 build - the price is roughly ten megabytes
      instead of a few hundred kilobytes.
      Windows Forms is not officially supported by Native AOT: the pieces that need
      COM (drag and drop, the clipboard, accessibility, ActiveX) marshal through
      interfaces the AOT compiler cannot generate at run time. WinFormsComInterop
      below is the community answer to that - see Program.cs.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Native AOT always produces a single architecture binary; x64 as before. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <!--
      The SDK refuses to trim a Windows Forms application (NETSDK1175), and Native AOT
      implies trimming. This internal switch is the documented escape hatch used by
      WinFormsComInterop; it only removes the blanket error, the trim analysers stay on.
    -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- Smaller is better for a tray utility; the app is nowhere near CPU bound. -->
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
    <AssemblyTitle>必应壁纸</AssemblyTitle>
    <Product>必应壁纸</Product>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <Copyright>Copyright © 2026 pexcn · GPL-3.0-or-later</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ComWrappers implementation for Windows Forms. Without it the first COM call the
      framework makes inside an AOT binary throws NotSupportedException.
      https://github.com/kant2002/WinFormsComInterop
    -->
    <PackageReference Include="WinFormsComInterop" Version="0.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The same file twice: ApplicationIcon above puts it in the Win32 resources of
      the executable (Explorer, task bar, Alt+Tab), this embeds it so the tray can
      pick the frame that matches the current DPI. See UI/AppIcon.cs.
      The logical name is spelled out instead of relying on the RootNamespace plus
      folder convention.
    -->
    <EmbeddedResource Include="Resources\app.ico">
      <LogicalName>BingWallpaper.Resources.app.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
