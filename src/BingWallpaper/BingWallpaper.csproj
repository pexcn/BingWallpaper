<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!--
      InvariantGlobalization is deliberately NOT enabled. In invariant mode
      CultureInfo.GetCultureInfo(lcid) throws, and WinForms calls it from
      Control.WmInputLangChange whenever the user switches the keyboard layout
      or IME while a text control has focus - which crashed the settings window
      with CultureNotFoundException (0x0804 = zh-CN). On Windows 10 1903+ .NET
      uses the ICU that ships with the OS, so keeping globalization enabled
      costs no measurable binary size here.
    -->
    <!--
      WFO0003 asks to declare high DPI awareness either in the manifest or through
      the project property, not both. Both are declared on purpose: the manifest
      entry takes effect before any managed code runs, and the project property
      keeps the WinForms tooling in sync. The duplication is consistent
      (PerMonitorV2 in both places), so the warning is suppressed.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>BingWallpaper</AssemblyName>
    <RootNamespace>BingWallpaper</RootNamespace>
    <AssemblyTitle>BingWallpaper</AssemblyTitle>
    <Product>BingWallpaper</Product>
    <Description>Unofficial, portable Bing daily wallpaper client for Windows.</Description>
    <Company>BingWallpaper contributors</Company>
    <Copyright>Copyright (c) BingWallpaper contributors</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <LangVersion>latest</LangVersion>
    <!-- Reproducible-ish output; keeps the published tree to a single exe. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
