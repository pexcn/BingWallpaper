<Window
    x:Class="BingWallpaper.UI.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Selectable, copyable text: the user has no debugger, so an exception must
        never disappear behind a window that closes in a flash.
    -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadlineText"
                   Grid.Row="0"
                   Margin="4,0,4,12"
                   TextWrapping="Wrap"
                   Style="{ThemeResource SubtitleTextBlockStyle}" />

        <TextBox x:Name="DetailsText"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="复制到剪贴板" MinWidth="132" />
            <Button x:Name="CloseButton" Content="关闭" MinWidth="92" />
        </StackPanel>
    </Grid>
</Window>
