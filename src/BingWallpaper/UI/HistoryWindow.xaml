<Window
    x:Class="BingWallpaper.UI.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingWallpaper.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Thumbnail grid of the last 8 days: a click applies a picture and pins it.
        The status line at the bottom doubles as the place where a title is shown in
        full - the tile itself has to cut long ones off at its own width.
    -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <GridView x:Name="ImageGrid"
                  Grid.Row="0"
                  Padding="12"
                  IsItemClickEnabled="True"
                  SelectionMode="None"
                  ItemClick="OnItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryItem">
                    <Grid Width="200" Margin="4,4,4,8" ToolTipService.ToolTip="{x:Bind TitleText}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Height="113"
                                CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>

                        <Border Grid.Row="0"
                                Visibility="{x:Bind BadgeVisibility, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="6"
                                Padding="6,2,6,2"
                                CornerRadius="10"
                                Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="{x:Bind BadgeText, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="{x:Bind DateText}"
                                   Margin="2,6,2,0"
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="2"
                                   Text="{x:Bind TitleText}"
                                   Margin="2,2,2,0"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   Style="{ThemeResource BodyTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="16,8,16,10"
                   TextTrimming="CharacterEllipsis"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Text="正在加载…" />
    </Grid>
</Window>
